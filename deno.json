{
  "name": "modpack-quest-translator",
  "version": "1.0.0",
  "exports": "./src/cli/main.ts",
  "tasks": {
    "check": "deno check src/cli/main.ts",
    "test": "deno test -A",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "build": "deno compile -A --output dist/modpack-quest-translator src/cli/main.ts",
    "verify": "deno fmt --check && deno lint && deno check src/cli/main.ts && deno test -A"
  },
  "imports": {
    "@std/assert": "https://deno.land/std@0.219.0/assert/mod.ts",
    "@std/path": "https://deno.land/std@0.219.0/path/mod.ts",
    "@std/fs": "https://deno.land/std@0.219.0/fs/mod.ts",
    "@std/encoding/hex": "https://deno.land/std@0.219.0/encoding/hex.ts",
    "@std/testing/mock": "https://deno.land/std@0.219.0/testing/mock.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["dist/", "tests/fixtures/**/*.snbt"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] },
    "exclude": ["dist/"]
  },
  "exclude": ["dist/", ".tmp/"]
}
