{
  "name": "modpack-quest-translator",
  "version": "1.1.2",
  "exports": "./src/cli/main.ts",
  "tasks": {
    "check": "deno check src/cli/main.ts src/installer/main.ts src/packager/main.ts tools/bundle_e2e.ts tools/script_installer_e2e.ts",
    "test": "deno test -A",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "build": "deno compile -A --output dist/modpack-quest-translator src/cli/main.ts",
    "build:installer:linux": "deno compile --allow-read --allow-write --target x86_64-unknown-linux-gnu --output dist/bin/mqt-installer-linux-x86_64 src/installer/main.ts",
    "build:installer:windows": "deno compile --allow-read --allow-write --target x86_64-pc-windows-msvc --output dist/bin/mqt-installer-windows-x86_64.exe src/installer/main.ts",
    "build:installers": "deno task build:installer:linux && deno task build:installer:windows",
    "package-installer": "deno run --allow-read --allow-write src/packager/main.ts",
    "bundle": "deno task build:installers && deno run --allow-read --allow-write src/packager/main.ts --binaries dist/bin",
    "e2e:bundle": "deno run -A tools/bundle_e2e.ts",
    "e2e:scripts": "deno run -A tools/script_installer_e2e.ts",
    "verify": "deno fmt --check && deno lint && deno task check && deno test -A"
  },
  "imports": {
    "@std/assert": "https://deno.land/std@0.219.0/assert/mod.ts",
    "@std/path": "https://deno.land/std@0.219.0/path/mod.ts",
    "@std/fs": "https://deno.land/std@0.219.0/fs/mod.ts",
    "@std/encoding/hex": "https://deno.land/std@0.219.0/encoding/hex.ts",
    "@std/testing/mock": "https://deno.land/std@0.219.0/testing/mock.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      "dist/",
      "tests/fixtures/**/*.snbt"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "exclude": [
      "dist/"
    ]
  },
  "exclude": [
    "dist/",
    ".tmp/"
  ]
}
